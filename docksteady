#!/usr/bin/env python3
"""docksteady: keep a macOS multi-monitor arrangement steady when the Mac
cannot tell identical displays apart.

Identical panels often ship the same placeholder EDID serial, so macOS
cannot distinguish them and may trade their identities on wake or replug:
every arrangement store stays self-consistent while the physical panels
show swapped content and mirrored geometry. docksteady grounds each
window-server display in its panel's immutable factory serial (readable
per SoC display pipe in IOKit, bridged to the window server through the
CoreDisplay info dictionary) and enforces the arrangement you blessed:
init and save record your actual origins, so any geometry of the two
panels plus the laptop is replayed exactly; configs without recorded
origins get the default shape (externals side by side with a central
seam, laptop centred underneath).

Commands:
  init    detect the attached panels, choose which is left and right,
          write the configuration, and arm the automatic triggers (a
          LaunchAgent that runs at login and on a poll interval, and a
          sleepwatcher wake hook). Lid open and clamshell each record
          their own geometry; run init (or save) once in each mode you
          use. Flags: --left SERIAL --right SERIAL --poll SECONDS --yes.
  apply   enforce the arrangement; no-op when already correct. When it
          acts, it posts a notification (config notify: "banner"), or
          with notify: "dialog" a dialog that stays up to dialog_timeout
          seconds and offers to run swap-windows. Flags: --retries N
          --quiet --dry-run.
  swap    exchange the two panels' blessed sides and re-apply. Use once
          after init if the sides came out backwards. Note: window
          content rides the display identity, not the frame, so swap
          corrects geometry and mouse behaviour; use swap-windows for
          the windows themselves.
  swap-windows
          move every standard window on one external to the same spot on
          the other, via the Accessibility API. The content-level
          recovery after an identity flip. Covers windows on the
          currently visible Space of each display; with
          --with-fullscreen (or config swap_fullscreen for the dialog
          button) full-screen windows are also carried across in tiers:
          recorded, un-fullscreened, swapped as standard windows, then
          re-fullscreened one by one so each lands on its new display.
          Split View pairs come back as separate full-screen Spaces.
          Other desktops are dragged across in Mission Control. Needs
          Accessibility permission for the invoking context.
  save    bless the current arrangement as the good one.
  status  print the parsed current state.
  probe FRAGMENT
          diagnostic: list processes matching FRAGMENT with visibility,
          window count, and window geometry, through the same
          python-to-osascript chain swap-windows uses.
  pause [minutes]
          suspend automatic enforcement (default 60 min). Enforcement
          also skips while System Settings is the frontmost app, so
          manual drags are never fought.
  resume  lift a pause early.
  notify banner|dialog|off
          set how enforcement announces itself, without editing the
          config file by hand.
  set KEY VALUE
          change a setting from the command line: notify,
          dialog_timeout, swap_fullscreen, poll_seconds.
  disarm  unload the LaunchAgent and remove the wake hook (run before
          uninstalling); init re-arms them.
  version print the version.

docksteady acts only when both configured panels are attached (checked by
factory serial in IOKit); screens at any other location are never
touched. Never disable one of the panels with displayplacer
(enabled:false): the disabled panel goes fully offline and only a
physical replug, possibly with a dock power-cycle, brings it back.

Files: ~/.config/docksteady/{config.json,state.json},
       ~/Library/Logs/docksteady.log
"""

import ctypes
import fcntl
import json
import plistlib
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

VERSION = "0.3.2"
IOREG = "/usr/sbin/ioreg"
CONFIG_DIR = Path.home() / ".config" / "docksteady"
CONFIG_FILE = CONFIG_DIR / "config.json"
STATE_FILE = CONFIG_DIR / "state.json"
LOCK_FILE = CONFIG_DIR / "lock"
PAUSE_FILE = CONFIG_DIR / "pause-until"
SKIP_FILE = CONFIG_DIR / "last-skip"
LOG_FILE = Path.home() / "Library" / "Logs" / "docksteady.log"
AGENT_LABEL = "dk.denfrievilje.docksteady"
AGENT_PLIST = Path.home() / "Library" / "LaunchAgents" / f"{AGENT_LABEL}.plist"
WAKEUP = Path.home() / ".wakeup"
HOOK_BEGIN = "# >>> docksteady wake hook >>>"
HOOK_END = "# <<< docksteady wake hook <<<"

QUIET = False


def log(msg):
    line = f"{datetime.now().isoformat(timespec='seconds')} {msg}"
    print(line)
    try:
        with open(LOG_FILE, "a") as fh:
            fh.write(line + "\n")
    except OSError:
        pass


def log_info(msg):
    """Routine outcomes: silenced under --quiet (the poll and other
    automatic triggers), so the log holds only actions and anomalies."""
    if not QUIET:
        log(msg)


def load_config():
    try:
        return json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        return None


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2) + "\n")


def displayplacer_path(cfg):
    for candidate in ([cfg.get("displayplacer")] if cfg and cfg.get("displayplacer") else []) + [
            "/opt/homebrew/bin/displayplacer", "/usr/local/bin/displayplacer"]:
        if candidate and Path(candidate).exists():
            return candidate
    return None


def parse_list(dp):
    out = subprocess.run([dp, "list"], capture_output=True, text=True)
    screens = []
    for block in out.stdout.split("Persistent screen id: ")[1:]:
        s = {"persistent": block.split("\n", 1)[0].strip()}
        for key, pattern, cast in (
            ("contextual", r"Contextual screen id: (\S+)", str),
            ("type", r"Type: (.+)", str),
            ("hz", r"Hertz: (\d+)", int),
            ("depth", r"Color Depth: (\d+)", int),
            ("scaling", r"Scaling: (\S+)", str),
            ("degree", r"Rotation: (\d+)", int),
        ):
            m = re.search(pattern, block)
            if m:
                s[key] = cast(m.group(1).strip())
        m = re.search(r"Resolution: (\d+)x(\d+)", block)
        if m:
            s["w"], s["h"] = int(m.group(1)), int(m.group(2))
        m = re.search(r"Origin: \((-?\d+),(-?\d+)\)", block)
        if m:
            s["x"], s["y"] = int(m.group(1)), int(m.group(2))
        screens.append(s)
    mac = next((s for s in screens if "MacBook built in" in s.get("type", "")), None)
    exts = [s for s in screens if s is not mac]
    return mac, exts


def profile(s, x, y):
    parts = [f"id:{s['persistent']}", f"res:{s['w']}x{s['h']}"]
    if "hz" in s:
        parts.append(f"hz:{s['hz']}")
    parts += [
        f"color_depth:{s.get('depth', 8)}",
        "enabled:true",
        f"scaling:{s.get('scaling', 'on')}",
        f"origin:({x},{y})",
        f"degree:{s.get('degree', 0)}",
    ]
    return " ".join(parts)


def pipe_map(only=None):
    """Map factory serial -> SoC display pipe (dispext0/1...), from IOKit.
    `only` restricts to a set of serials; None returns every panel seen."""
    out = subprocess.run([IOREG, "-lw0"], capture_output=True, text=True)
    pipes, current = {}, None
    for line in out.stdout.splitlines():
        m = re.search(r"\+-o (disp\w+)@", line)
        if m:
            current = m.group(1)
        m = re.search(r'"AlphanumericSerialNumber"="([^"]+)"', line)
        if m and current and (only is None or m.group(1) in only):
            pipes[m.group(1)] = current
    return pipes


def cg_serial_map(pipes):
    """Map window-server display UUID -> factory serial.

    Uses the private CoreDisplay info dictionary: IODisplayLocation names
    the SoC pipe each display renders to, IOKit says which panel each
    pipe drives. Returns {} when the bridge is unavailable so callers
    fall back to the saved UUID snapshot or current positions.
    """
    try:
        cg = ctypes.CDLL("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
        cf = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
        cd = ctypes.CDLL("/System/Library/Frameworks/CoreDisplay.framework/CoreDisplay")
        cd.CoreDisplay_DisplayCreateInfoDictionary.restype = ctypes.c_void_p
        cd.CoreDisplay_DisplayCreateInfoDictionary.argtypes = [ctypes.c_uint32]
        cf.CFCopyDescription.restype = ctypes.c_void_p
        cf.CFCopyDescription.argtypes = [ctypes.c_void_p]
        cf.CFStringGetCString.argtypes = [
            ctypes.c_void_p, ctypes.c_char_p, ctypes.c_long, ctypes.c_uint32]
        cf.CFRelease.argtypes = [ctypes.c_void_p]
        count = ctypes.c_uint32(0)
        ids = (ctypes.c_uint32 * 16)()
        cg.CGGetOnlineDisplayList(16, ids, ctypes.byref(count))
        by_pipe = {p: s for s, p in pipes.items()}
        result = {}
        for i in range(count.value):
            info = cd.CoreDisplay_DisplayCreateInfoDictionary(ids[i])
            if not info:
                continue
            d = cf.CFCopyDescription(info)
            buf = ctypes.create_string_buffer(1_000_000)
            cf.CFStringGetCString(d, buf, len(buf), 0x08000100)
            text = buf.value.decode("utf-8", "replace")
            cf.CFRelease(d)
            cf.CFRelease(info)
            mu = re.search(r'kCGDisplayUUID = "([0-9A-Fa-f-]+)"', text)
            mp = re.search(r'IODisplayLocation = "[^"]*/(disp\w+)@', text)
            if mu and mp and by_pipe.get(mp.group(1)):
                result[mu.group(1)] = by_pipe[mp.group(1)]
        return result
    except Exception as e:  # private API; degrade gracefully on any change
        log(f"serial bridge unavailable ({e}); using saved/position sides")
        return {}


def paused():
    try:
        until = float(PAUSE_FILE.read_text().strip())
    except (OSError, ValueError):
        return False
    if time.time() < until:
        return True
    try:
        PAUSE_FILE.unlink()
    except OSError:
        pass
    return False


def settings_frontmost():
    """True while System Settings is the active app (user likely mid-drag).
    A merely running Settings process must not block enforcement: it can
    linger for days and would silently disable every trigger."""
    r = subprocess.run(["/usr/bin/lsappinfo", "front"],
                       capture_output=True, text=True)
    asn = r.stdout.strip()
    if not asn:
        return False
    r = subprocess.run(["/usr/bin/lsappinfo", "info", "-only", "name", asn],
                       capture_output=True, text=True)
    return "System Settings" in r.stdout


def log_skip(key, msg):
    """Skip reasons log even under --quiet, once per distinct state, so an
    always-skipping install never has a silent, empty log."""
    try:
        if SKIP_FILE.read_text() == key:
            log_info(msg)
            return
    except OSError:
        pass
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        SKIP_FILE.write_text(key)
    except OSError:
        pass
    log(msg)


def clear_skip():
    try:
        SKIP_FILE.unlink()
    except OSError:
        pass


def panels_ready(cfg, mac, exts, ctx, pipes):
    """The MacBook's own screen is optional: clamshell mode (lid closed,
    externals only) is a managed configuration of its own."""
    missing = {cfg["left"], cfg["right"]} - set(pipes)
    if missing:
        log_skip(f"missing:{sorted(missing)}",
                 f"{ctx}: configured panels not attached (missing {sorted(missing)}); "
                 "leaving displays untouched")
        return False
    if len(exts) != 2:
        log_skip(f"screens:{len(exts)}",
                 f"{ctx}: unexpected screen set "
                 f"(mac={'yes' if mac else 'no, clamshell'}, externals={len(exts)}); "
                 "leaving displays untouched")
        return False
    return True


def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return None


def snapshot_state(mac, left, right):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps({
        "mac": mac["persistent"] if mac else None,
        "left": left["persistent"],
        "right": right["persistent"],
        "saved_at": datetime.now().isoformat(timespec="seconds"),
    }, indent=2) + "\n")


def pick_sides(cfg, exts, smap):
    """Return (left, right, source). The config's blessed factory serials
    win; then the saved UUID snapshot; then current x order."""
    by_serial = {smap.get(e["persistent"]): e for e in exts}
    if set(by_serial) == {cfg["left"], cfg["right"]}:
        return (by_serial[cfg["left"]], by_serial[cfg["right"]],
                f"factory serials (left={cfg['left']} right={cfg['right']})")
    state = load_state() or {}
    if {state.get("left"), state.get("right")} == {e["persistent"] for e in exts}:
        by_id = {e["persistent"]: e for e in exts}
        return (by_id[state["left"]], by_id[state["right"]],
                "saved UUID snapshot (serial bridge unavailable)")
    left, right = sorted(exts, key=lambda e: (e.get("x", 0), e.get("contextual", "")))
    return left, right, "current positions (no matching saved state)"


def origins_key(mac):
    """Lid-open and clamshell have different coordinate frames (clamshell
    re-homes the main display to an external), so each mode keeps its own
    recorded geometry."""
    return "origins" if mac else "origins_clamshell"


def targets(cfg, mac, left, right):
    """Target origin per display. A blessing recorded by init or save
    carries the actual arranged origins keyed by serial, so any geometry
    is replayed exactly; without a recording for the current mode the
    default shape is computed. Stored origins go stale if resolutions or
    scaling change; rerun docksteady save after such changes."""
    saved = cfg.get(origins_key(mac)) or {}
    need = [cfg["left"], cfg["right"]] + (["mac"] if mac else [])
    if all(k in saved for k in need):
        t = {
            left["persistent"]: tuple(saved[cfg["left"]]),
            right["persistent"]: tuple(saved[cfg["right"]]),
        }
        if mac:
            t[mac["persistent"]] = tuple(saved["mac"])
        return t
    if mac:
        seam = mac["w"] // 2
        return {
            mac["persistent"]: (0, 0),
            left["persistent"]: (seam - left["w"], -left["h"]),
            right["persistent"]: (seam, -right["h"]),
        }
    return {
        left["persistent"]: (-left["w"], 0),
        right["persistent"]: (0, 0),
    }


def record_origins(cfg, mac, left, right):
    origins = {
        cfg["left"]: [left.get("x"), left.get("y")],
        cfg["right"]: [right.get("x"), right.get("y")],
    }
    if mac:
        origins["mac"] = [mac.get("x", 0), mac.get("y", 0)]
    cfg[origins_key(mac)] = origins


def notify_mode(cfg):
    v = cfg.get("notify", True)
    if v in (True, "banner"):
        return "banner"
    if v == "dialog":
        return "dialog"
    return "off"


def notify(cfg, text):
    """Post-enforcement notice. banner: a transient macOS notification.
    dialog: a dialog that stays up to dialog_timeout seconds and offers
    to run swap-windows; the swap runs under this process, so macOS asks
    once for assistive access for it, and declining keeps the
    run-from-terminal workflow."""
    mode = notify_mode(cfg)
    if mode == "off":
        return 0
    if mode == "banner":
        try:
            subprocess.run(
                ["/usr/bin/osascript", "-e",
                 f'display notification "{text}" with title "docksteady"'],
                capture_output=True, timeout=10)
        except Exception:
            pass
        return 0
    timeout = int(cfg.get("dialog_timeout", 120))
    script = (f'display dialog "{text}" '
              'buttons {"Dismiss", "Swap windows"} default button "Swap windows" '
              f'with title "docksteady" giving up after {timeout}')
    try:
        r = subprocess.run(["/usr/bin/osascript", "-e", script],
                           capture_output=True, text=True, timeout=timeout + 15)
    except subprocess.TimeoutExpired:
        return 0
    if "button returned:Swap windows" in r.stdout and "gave up:true" not in r.stdout:
        log("dialog: swapping windows at the user's request")
        return cmd_swap_windows(dry=False,
                                with_fullscreen=cfg.get("swap_fullscreen", False))
    return 0


def run_displayplacer(dp, mac, left, right, tgt, dry):
    args = [profile(s, *tgt[s["persistent"]])
            for s in ([mac] if mac else []) + [left, right]]
    if dry:
        log("dry-run: displayplacer " + " ".join(f'"{a}"' for a in args))
        return True
    r = subprocess.run([dp, *args], capture_output=True, text=True)
    if r.returncode != 0:
        log(f"displayplacer failed ({r.returncode}): {r.stdout.strip()} {r.stderr.strip()}")
        return False
    return True


def require_setup():
    cfg = load_config()
    if not cfg or "left" not in cfg or "right" not in cfg:
        print("docksteady is not configured yet: run `docksteady init`")
        sys.exit(1)
    dp = displayplacer_path(cfg)
    if not dp:
        print("displayplacer not found: brew install jakehilborn/jakehilborn/displayplacer")
        sys.exit(1)
    return cfg, dp


def cmd_apply(retries, dry):
    cfg, dp = require_setup()
    if paused():
        log_info("apply: enforcement paused (docksteady resume to lift)")
        return 0
    if settings_frontmost():
        log_info("apply: System Settings is frontmost; not enforcing while you arrange")
        return 0
    for attempt in range(1, retries + 1):
        mac, exts = parse_list(dp)
        pipes = pipe_map({cfg["left"], cfg["right"]})
        if not panels_ready(cfg, mac, exts, f"apply attempt {attempt}/{retries}", pipes):
            if attempt < retries:
                time.sleep(8)
            continue
        smap = cg_serial_map(pipes)
        left, right, source = pick_sides(cfg, exts, smap)
        tgt = targets(cfg, mac, left, right)
        screens = ([mac] if mac else []) + [left, right]
        current = {s["persistent"]: (s.get("x"), s.get("y")) for s in screens}
        if current == tgt:
            clear_skip()
            log_info(f"attempt {attempt}: layout correct (sides from {source})")
            return 0
        log(f"attempt {attempt}: enforcing layout (sides from {source}); "
            f"current={current} target={tgt}")
        if run_displayplacer(dp, mac, left, right, tgt, dry) and not dry:
            clear_skip()
            snapshot_state(mac, left, right)
            notify(cfg, "Arrangement re-pinned. If window contents traded "
                        "sides, swap them back now.")
            return 0
        if dry:
            return 0
        if attempt < retries:
            time.sleep(8)
    return 1


def cmd_swap(dry):
    cfg, dp = require_setup()
    mac, exts = parse_list(dp)
    pipes = pipe_map({cfg["left"], cfg["right"]})
    if not panels_ready(cfg, mac, exts, "swap", pipes):
        return 1
    smap = cg_serial_map(pipes)
    if set(smap.values()) == {cfg["left"], cfg["right"]}:
        cfg["left"], cfg["right"] = cfg["right"], cfg["left"]
        for key in ("origins", "origins_clamshell"):
            origins = cfg.get(key) or {}
            if cfg["left"] in origins and cfg["right"] in origins:
                origins[cfg["left"]], origins[cfg["right"]] = (
                    origins[cfg["right"]], origins[cfg["left"]])
        if not dry:
            save_config(cfg)
        left, right, _ = pick_sides(cfg, exts, smap)
        log(f"swap: blessed sides flipped (left={cfg['left']} right={cfg['right']})")
    else:
        left, right, source = pick_sides(cfg, exts, smap)
        left, right = right, left
        log(f"swap: serial bridge unavailable; exchanging frames only "
            f"(previous sides from {source}); blessing unchanged")
    if run_displayplacer(dp, mac, left, right, targets(cfg, mac, left, right), dry):
        if not dry:
            snapshot_state(mac, left, right)
        return 0
    return 1


def cmd_save():
    cfg, dp = require_setup()
    mac, exts = parse_list(dp)
    pipes = pipe_map({cfg["left"], cfg["right"]})
    if not panels_ready(cfg, mac, exts, "save", pipes):
        return 1
    smap = cg_serial_map(pipes)
    left, right = sorted(exts, key=lambda e: (e.get("x", 0), e.get("contextual", "")))
    ls, rs = smap.get(left["persistent"]), smap.get(right["persistent"])
    if ls and rs:
        cfg["left"], cfg["right"] = ls, rs
        record_origins(cfg, mac, left, right)
        save_config(cfg)
    snapshot_state(mac, left, right)
    log(f"saved: left={ls or left['persistent']} right={rs or right['persistent']} "
        f"origins={'recorded' if ls and rs else 'unchanged'}")
    return 0


def cmd_status():
    cfg = load_config()
    if not cfg:
        print("not configured: run `docksteady init`")
        return 1
    dp = displayplacer_path(cfg)
    if not dp:
        print("displayplacer not found: brew install jakehilborn/jakehilborn/displayplacer")
        return 1
    mac, exts = parse_list(dp)
    smap = cg_serial_map(pipe_map())
    for s in ([mac] if mac else []) + exts:
        print(f"{s.get('type', '?'):28} id={s['persistent']} "
              f"panel={smap.get(s['persistent'], 'unknown')} "
              f"res={s.get('w')}x{s.get('h')} origin=({s.get('x')},{s.get('y')})")
    print(f"config: {cfg}")
    print(f"state:  {load_state()}")
    print(f"paused: {paused()}; settings frontmost: {settings_frontmost()}")
    return 0


def record_and_exit_fullscreen(lrect, rrect):
    """Phase one of the full-screen tier: find full-screen windows on the
    managed panels (their AX position equals the display origin, tested
    against each panel's own rect so laptop full-screen windows are never
    grabbed), exit full screen, and return (app, title) pairs for later
    restoration. Only windows on each display's currently visible Space
    are reachable; a full-screen Space that is not showing is invisible
    to the scan."""
    conds = " or ".join(
        f"(wx >= {x0} and wx < {x1} and wy >= {y0} and wy < {y1})"
        for (x0, y0, x1, y1) in (lrect, rrect))
    # the window is recorded only after it actually left full screen, so
    # a window that refuses is never counted as carried
    script = f'''
tell application "System Events"
  set out to ""
  repeat with proc in (application processes whose visible is true)
    try
      repeat with w in windows of proc
        try
          if value of attribute "AXFullScreen" of w is true then
            set {{wx, wy}} to position of w
            if {conds} then
              set value of attribute "AXFullScreen" of w to false
              delay 1.0
              set out to out & (name of proc) & tab & (name of w) & linefeed
            end if
          end if
        end try
      end repeat
    end try
  end repeat
  return out
end tell'''
    try:
        r = subprocess.run(["/usr/bin/osascript", "-e", script],
                           capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        log("swap-windows: full-screen scan timed out; no windows recorded")
        return []
    pairs = []
    for line in r.stdout.splitlines():
        if "\t" in line:
            app, title = line.split("\t", 1)
            pairs.append((app, title))
    return pairs


def restore_fullscreen(pairs):
    """Phase three: re-fullscreen each recorded window, one at a time so
    Space creation never races. Each window fullscreens onto the display
    that now contains it, which is the other monitor after the swap."""
    esc = lambda s: s.replace("\\", "\\\\").replace('"', '\\"')
    restored = 0
    for app, title in pairs:
        script = f'''
tell application "System Events"
  set w to first window of (first application process whose name is "{esc(app)}") ¬
    whose name is "{esc(title)}"
  set value of attribute "AXFullScreen" of w to true
  delay 1.5
  return "ok"
end tell'''
        try:
            r = subprocess.run(["/usr/bin/osascript", "-e", script],
                               capture_output=True, text=True, timeout=60)
        except subprocess.TimeoutExpired:
            log(f"swap-windows: re-fullscreen timed out for {app} / {title[:40]}")
            continue
        if r.returncode == 0:
            restored += 1
        else:
            log(f"swap-windows: could not re-fullscreen {app} / {title[:40]} "
                "(window gone or title changed); it stays a standard window")
    return restored


def cmd_swap_windows(dry, with_fullscreen=False):
    cfg, dp = require_setup()
    mac, exts = parse_list(dp)
    pipes = pipe_map({cfg["left"], cfg["right"]})
    if not panels_ready(cfg, mac, exts, "swap-windows", pipes):
        return 1
    left, right = sorted(exts, key=lambda e: e["x"])
    # per-panel rects, so windows on the laptop or any other region are
    # never grabbed, whatever geometry is blessed; the offset between the
    # panels' origins carries height differences too
    dxr, dyr = right["x"] - left["x"], right["y"] - left["y"]
    lrect = (left["x"], left["y"], left["x"] + left["w"], left["y"] + left["h"])
    rrect = (right["x"], right["y"], right["x"] + right["w"], right["y"] + right["h"])
    if dry:
        log(f"dry-run swap-windows: left rect={lrect} right rect={rrect} "
            f"offset=({dxr},{dyr})")
        return 0
    probe = subprocess.run(
        ["/usr/bin/osascript", "-e",
         'tell application "System Events" to return count of windows of '
         '(first application process whose frontmost is true)'],
        capture_output=True, text=True, timeout=30)
    if probe.returncode != 0:
        log(f"swap-windows: no assistive access for this terminal "
            f"({probe.stderr.strip()[:160]}); grant Accessibility permission "
            "in System Settings > Privacy & Security, then rerun")
        return 1
    fs_pairs = []
    if with_fullscreen:
        fs_pairs = record_and_exit_fullscreen(lrect, rrect)
        if fs_pairs:
            log(f"swap-windows: {len(fs_pairs)} full-screen window(s) "
                "recorded and un-fullscreened")
            time.sleep(2)
        else:
            log("swap-windows: no full-screen windows found on the visible "
                "Spaces of the panels (hidden full-screen Spaces are out of "
                "reach; bring one on screen and rerun, or drag its Space "
                "across in Mission Control)")
    script = f'''
tell application "System Events"
  set movedCount to 0
  repeat with proc in (application processes whose visible is true)
    try
      repeat with w in windows of proc
        try
          set sr to ""
          try
            set sr to subrole of w as text
          end try
          set {{wx, wy}} to position of w
          set {{ww, wh}} to size of w
          set midX to wx + ww / 2
          set midY to wy + wh / 2
          if sr is "AXStandardWindow" or sr is "" then
            if midX >= {lrect[0]} and midX < {lrect[2]} and midY >= {lrect[1]} and midY < {lrect[3]} then
              set position of w to {{wx + {dxr}, wy + {dyr}}}
              set movedCount to movedCount + 1
            else if midX >= {rrect[0]} and midX < {rrect[2]} and midY >= {rrect[1]} and midY < {rrect[3]} then
              set position of w to {{wx - {dxr}, wy - {dyr}}}
              set movedCount to movedCount + 1
            end if
          end if
        end try
      end repeat
    end try
  end repeat
  return movedCount
end tell'''
    try:
        r = subprocess.run(["/usr/bin/osascript", "-e", script],
                           capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        log("swap-windows timed out")
        return 1
    if r.returncode != 0:
        log(f"swap-windows failed ({r.returncode}): {r.stderr.strip()[:300]}")
        return 1
    log(f"swap-windows: moved {r.stdout.strip()} windows between the externals")
    if fs_pairs:
        restored = restore_fullscreen(fs_pairs)
        log(f"swap-windows: re-fullscreened {restored}/{len(fs_pairs)} "
            "window(s) on their new displays")
    return 0


def cmd_probe(fragment):
    if not re.fullmatch(r"[A-Za-z0-9 ._-]{1,40}", fragment):
        print("probe: fragment must be plain text (letters, digits, space, ._-)")
        return 1
    script = f'''
tell application "System Events"
  set out to ""
  repeat with proc in (application processes whose name contains "{fragment}")
    set out to out & (name of proc) & " visible=" & (visible of proc as text) ¬
      & " windows=" & ((count of windows of proc) as text) & linefeed
    repeat with w in windows of proc
      set {{wx, wy}} to position of w
      set {{ww, wh}} to size of w
      set sr to "?"
      try
        set sr to subrole of w as text
      end try
      set out to out & "  window: pos=(" & wx & "," & wy & ") size=(" ¬
        & ww & "x" & wh & ") subrole=" & sr & linefeed
    end repeat
  end repeat
  return out
end tell'''
    r = subprocess.run(["/usr/bin/osascript", "-e", script],
                       capture_output=True, text=True, timeout=60)
    print(r.stdout.strip() or "(no matching visible process output)")
    if r.returncode != 0:
        print(f"probe failed ({r.returncode}): {r.stderr.strip()[:300]}")
        return 1
    return 0


def cmd_set(key, value):
    cfg = load_config()
    if not cfg:
        print("docksteady is not configured yet: run `docksteady init`")
        return 1
    if key == "notify":
        return cmd_set_notify(value)
    if key in ("dialog_timeout", "poll_seconds"):
        try:
            cfg[key] = int(value)
        except ValueError:
            print(f"{key} takes a number of seconds")
            return 1
    elif key == "swap_fullscreen":
        if value not in ("true", "false"):
            print("swap_fullscreen takes true or false")
            return 1
        cfg[key] = value == "true"
    else:
        print("settable keys: notify, dialog_timeout, swap_fullscreen, poll_seconds")
        return 1
    save_config(cfg)
    print(f"{key} set to {value}")
    if key == "poll_seconds":
        print("run `docksteady init` to apply the new interval to the schedule")
    return 0


def cmd_set_notify(value):
    if value not in ("banner", "dialog", "off"):
        print("usage: docksteady notify banner|dialog|off")
        return 1
    cfg = load_config()
    if not cfg:
        print("docksteady is not configured yet: run `docksteady init`")
        return 1
    cfg["notify"] = value
    save_config(cfg)
    print(f"notify mode set to {value}")
    return 0


def cmd_disarm():
    """Disarm the automatic triggers: unload and remove the LaunchAgent
    and take the wake hook out of ~/.wakeup. Run before uninstalling.
    Configuration and log stay; docksteady init re-arms."""
    uid = subprocess.run(["/usr/bin/id", "-u"], capture_output=True,
                         text=True).stdout.strip()
    subprocess.run(["/bin/launchctl", "bootout", f"gui/{uid}/{AGENT_LABEL}"],
                   capture_output=True)
    try:
        AGENT_PLIST.unlink()
        print(f"LaunchAgent removed: {AGENT_PLIST}")
    except OSError:
        print("LaunchAgent was not installed")
    if WAKEUP.exists():
        text = WAKEUP.read_text()
        if HOOK_BEGIN in text:
            text = re.sub(re.escape(HOOK_BEGIN) + r".*?" + re.escape(HOOK_END) + r"\n?",
                          "", text, flags=re.S)
            WAKEUP.write_text(text)
            print(f"wake hook removed from {WAKEUP}")
    print("triggers disarmed; docksteady init re-arms them")
    return 0


def cmd_pause(minutes):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    PAUSE_FILE.write_text(str(time.time() + minutes * 60))
    log(f"enforcement paused for {minutes} min (docksteady resume to lift)")
    return 0


def cmd_resume():
    try:
        PAUSE_FILE.unlink()
    except OSError:
        pass
    log("enforcement resumed")
    return 0


def self_path():
    """The command's stable path, for the LaunchAgent and wake hook.
    Deliberately not resolved through symlinks: a Homebrew install must
    record /opt/homebrew/bin/docksteady, not the versioned Cellar path
    that dies on the next upgrade."""
    argv0 = sys.argv[0]
    if "/" not in argv0:
        found = shutil.which(argv0)
        if found:
            return str(Path(found).absolute())
    return str(Path(argv0).absolute())


def install_agent(poll_seconds):
    me = self_path()
    AGENT_PLIST.parent.mkdir(parents=True, exist_ok=True)
    with open(AGENT_PLIST, "wb") as fh:
        plistlib.dump({
            "Label": AGENT_LABEL,
            # existence-guarded so a bare `brew uninstall` without disarm
            # leaves a silent no-op, not a binary-not-found every 45s
            "ProgramArguments": [
                "/bin/sh", "-c",
                f'[ -x "{me}" ] || exit 0; exec "{me}" apply --retries 6 --quiet'],
            "RunAtLoad": True,
            "StartInterval": poll_seconds,
        }, fh)
    uid = subprocess.run(["/usr/bin/id", "-u"], capture_output=True,
                         text=True).stdout.strip()
    subprocess.run(["/bin/launchctl", "bootout", f"gui/{uid}/{AGENT_LABEL}"],
                   capture_output=True)
    r = subprocess.run(["/bin/launchctl", "bootstrap", f"gui/{uid}", str(AGENT_PLIST)],
                       capture_output=True, text=True)
    return r.returncode == 0, me


def install_wake_hook(me):
    block = (f"{HOOK_BEGIN}\n"
             f'( [ -x "{me}" ] && "{me}" apply --retries 6 --quiet ) '
             f'>/dev/null 2>>"$HOME/Library/Logs/docksteady.log" &\n'
             f"{HOOK_END}\n")
    text = WAKEUP.read_text() if WAKEUP.exists() else "#!/bin/sh\n"
    if HOOK_BEGIN in text:
        text = re.sub(re.escape(HOOK_BEGIN) + r".*?" + re.escape(HOOK_END) + r"\n?",
                      block, text, flags=re.S)
    else:
        text = text.rstrip("\n") + "\n\n" + block
    WAKEUP.write_text(text)
    WAKEUP.chmod(0o755)


def sleepwatcher_running():
    r = subprocess.run(["/bin/launchctl", "list"], capture_output=True, text=True)
    return "sleepwatcher" in r.stdout


def cmd_init(argv):
    left_arg = right_arg = None
    yes = "--yes" in argv
    if "--left" in argv:
        left_arg = argv[argv.index("--left") + 1]
    if "--right" in argv:
        right_arg = argv[argv.index("--right") + 1]
    cfg = load_config() or {}
    poll = int(cfg.get("poll_seconds", 45))
    if "--poll" in argv:
        poll = int(argv[argv.index("--poll") + 1])

    dp = displayplacer_path(cfg)
    if not dp:
        print("displayplacer is required:\n"
              "  brew install jakehilborn/jakehilborn/displayplacer")
        return 1
    mac, exts = parse_list(dp)
    if len(exts) != 2:
        print(f"init needs exactly two external displays attached, lid open "
              f"or closed (found {len(exts)}); dock the machine and rerun")
        return 1
    pipes = pipe_map()
    smap = cg_serial_map(pipes)
    serials = {e["persistent"]: smap.get(e["persistent"]) for e in exts}
    if None in serials.values():
        print("could not read a factory serial for every external panel; "
              "docksteady needs the IOKit serial bridge to work on this machine")
        return 1

    by_x = sorted(exts, key=lambda e: e.get("x", 0))
    left_serial = left_arg or serials[by_x[0]["persistent"]]
    right_serial = right_arg or serials[by_x[1]["persistent"]]
    if {left_serial, right_serial} != set(serials.values()):
        print(f"--left/--right must name the attached panels: {sorted(serials.values())}")
        return 1

    print("Detected arrangement:")
    for e in by_x:
        print(f"  panel {serials[e['persistent']]} at origin "
              f"({e.get('x')},{e.get('y')})")
    print(f"Blessing: left={left_serial} right={right_serial} "
          "(taken from the current arrangement)")
    if not yes:
        answer = input("Is the current arrangement correct, including which "
                       "physical panel shows what? [y/N] ").strip().lower()
        if answer != "y":
            print("Arrange the displays correctly first (System Settings > "
                  "Displays), then rerun docksteady init. If only the sides "
                  "are backwards after init, run docksteady swap once.")
            return 1

    # merge into the existing config so a rerun of init never wipes
    # notify, dialog_timeout, or other hand-set keys
    cfg.update({"left": left_serial, "right": right_serial, "poll_seconds": poll})
    cfg.setdefault("notify", "banner")
    left, right, _ = pick_sides(cfg, exts, smap)
    record_origins(cfg, mac, left, right)
    save_config(cfg)
    snapshot_state(mac, left, right)
    ok, me = install_agent(poll)
    install_wake_hook(me)
    print(f"config written to {CONFIG_FILE}")
    print(f"LaunchAgent {'armed' if ok else 'FAILED to load'}: {AGENT_PLIST} "
          f"(login + every {poll}s)")
    print(f"wake hook installed in {WAKEUP}")
    if not sleepwatcher_running():
        print("sleepwatcher is not running; wake enforcement needs it:\n"
              "  brew install sleepwatcher && brew services start sleepwatcher")
    code = cmd_apply(retries=1, dry=False)
    print("initial apply: " + ("layout verified" if code == 0 else "check the log"))
    return 0


def main():
    global QUIET
    args = sys.argv[1:]
    dry = "--dry-run" in args
    QUIET = "--quiet" in args
    args = [a for a in args if a not in ("--dry-run", "--quiet")]
    cmd = args[0] if args else "help"
    retries = int(args[args.index("--retries") + 1]) if "--retries" in args else 1

    if cmd == "version":
        print(f"docksteady {VERSION}")
        return 0
    if cmd == "init":
        return cmd_init(args[1:])
    if cmd == "status":
        return cmd_status()
    if cmd == "probe":
        if len(args) < 2:
            print("usage: docksteady probe FRAGMENT")
            return 1
        return cmd_probe(args[1])
    if cmd == "pause":
        return cmd_pause(int(args[1]) if len(args) > 1 else 60)
    if cmd == "resume":
        return cmd_resume()
    if cmd == "notify":
        return cmd_set_notify(args[1] if len(args) > 1 else "")
    if cmd == "set":
        return cmd_set(args[1] if len(args) > 1 else "",
                       args[2] if len(args) > 2 else "")
    if cmd == "disarm":
        return cmd_disarm()

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOCK_FILE, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            log_info(f"{cmd}: another docksteady run holds the lock; exiting")
            return 0
        if cmd == "apply":
            return cmd_apply(retries, dry)
        if cmd == "swap":
            return cmd_swap(dry)
        if cmd == "swap-windows":
            return cmd_swap_windows(dry, with_fullscreen="--with-fullscreen" in args)
        if cmd == "save":
            return cmd_save()
        print(__doc__)
        return 0 if cmd == "help" else 1


if __name__ == "__main__":
    sys.exit(main())
